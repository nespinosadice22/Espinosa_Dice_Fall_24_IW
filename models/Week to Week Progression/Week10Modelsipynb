ntity Seized (kg)'].shift(2)\n","combined_df['Lagged_Log_BiWeekly_Quantity_Seized_3'] = combined_df.groupby('Department')['Log BiWeekly Quantity Seized (kg)'].shift(3)\n","combined_df['Lagged_Log_BiWeekly_Quantity_Seized_4'] = combined_df.groupby('Department')['Log BiWeekly Quantity Seized (kg)'].shift(4)\n","combined_df['Lagged_Log_BiWeekly_Quantity_Seized_5'] = combined_df.groupby('Department')['Log BiWeekly Quantity Seized (kg)'].shift(5)\n","combined_df['Lagged_Log_BiWeekly_Quantity_Seized_6'] = combined_df.groupby('Department')['Log BiWeekly Quantity Seized (kg)'].shift(6)\n","#rolling average\n","combined_df['Rolling_1M_Log_BiWeekly_Quantity'] = combined_df.groupby('Department')['Log BiWeekly Quantity Seized (kg)'].transform(lambda x: x.rolling(2, closed='left').mean())\n","combined_df['Rolling_2M_Log_BiWeekly_Quantity'] = combined_df.groupby('Department')['Log BiWeekly Quantity Seized (kg)'].transform(lambda x: x.rolling(4, closed='left').mean())\n","combined_df['Rolling_3M_Log_BiWeekly_Quantity'] = combined_df.groupby('Department')['Log BiWeekly Quantity Seized (kg)'].transform(lambda x: x.rolling(6, closed='left').mean())\n","\n","\n","# Add lagged rolling standard deviation (for volatility)\n","combined_df['Rolling_1M_Std_Log_BiWeekly_Quantity'] = combined_df.groupby('Department')['Log BiWeekly Quantity Seized (kg)'].transform(lambda x: x.rolling(2, closed='left').std())\n","\n","# 3 month minimum\n","combined_df['Rolling_1M_Min_Log_BiWeekly_Quantity'] = combined_df.groupby('Department')['Log BiWeekly Quantity Seized (kg)'].transform(\n","    lambda x: x.rolling(2, closed='left').min()\n",")\n","#3 month max\n","combined_df['Rolling_1M_Max_Log_BiWeekly_Quantity'] = combined_df.groupby('Department')['Log BiWeekly Quantity Seized (kg)'].transform(\n","    lambda x: x.rolling(2, closed='left').max()\n",")\n","#3 month range\n","combined_df['Rolling_1M_Range_Log_BiWeekly_Quantity'] = (\n","    combined_df['Rolling_1M_Max_Log_BiWeekly_Quantity'] - combined_df['